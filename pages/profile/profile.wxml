<!--pages/profile/profile.wxml-->
<view class="page">
  <!-- 品牌头部 -->
  <view class="brand">
    <view class="brand-logo">
      <view class="bowl">
        <view class="bowl-steam"></view>
        <view class="bowl-steam s2"></view>
        <view class="bowl-steam s3"></view>
      </view>
    </view>
    <view class="brand-name">附近面馆</view>
    <view class="brand-slogan">走几步，就有一碗面</view>
  </view>

  <!-- 信息卡 -->
  <view class="info-card">
    <view class="info-row">
      <text class="row-label">当前版本</text>
      <text class="row-value">{{versionDisplay}}</text>
    </view>
    <view class="info-row">
      <text class="row-label">地图服务</text>
      <text class="row-value">腾讯位置服务</text>
    </view>
    <view class="info-row no-line">
      <text class="row-label">搜索范围</text>
      <text class="row-value">附近 3 公里</text>
    </view>
  </view>

  <view class="footer">用心找面 · 不踩雷</view>
</view>
