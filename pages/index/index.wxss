/**index.wxss**/
.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===================== 顶部标题 ===================== */
.header {
  padding: 12rpx 8rpx 24rpx;
}
.header__title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-strong);
  letter-spacing: 0.5rpx;
}
.header__sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-weak);
}

/* ===================== 主卡片 ===================== */
.card {
  background-color: var(--surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

/* 切换面馆时的入场动画 */
.card.is-enter {
  animation: cardEnter 0.38s cubic-bezier(0.22, 1, 0.36, 1);
}
@keyframes cardEnter {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ---- 地图 ---- */
.card__map {
  position: relative;
  width: 100%;
  height: 360rpx;
  background-color: #e9ebee;
}
.map {
  width: 100%;
  height: 100%;
}
.map__locate {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background-color: #ffffff;
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transform: translateY(12rpx);
  transition: opacity 0.25s ease, transform 0.25s ease;
}
.map__locate.is-show {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}
.locate-pin {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 6rpx solid var(--brand);
  box-sizing: border-box;
}
.locate-pin::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background-color: var(--brand);
  transform: translate(-50%, -50%);
}

/* ---- 信息区 ---- */
.card__body {
  padding: 32rpx 32rpx 8rpx;
}
.rest-name {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-strong);
  line-height: 1.3;
}

.rest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.pill--primary {
  color: var(--brand-deep);
  background-color: var(--brand-soft);
}
.pill--accent {
  color: #C77700;
  background-color: var(--accent-soft);
}

/* ---- 步行时间高亮 ---- */
.rest-metric {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #FFF4EE 0%, #FFF9F2 100%);
  border-radius: var(--radius-md);
}
.metric__main {
  display: flex;
  align-items: baseline;
}
.metric__num {
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--brand-deep);
}
.metric__unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-deep);
}
.metric__divider {
  width: 2rpx;
  height: 56rpx;
  margin: 0 28rpx;
  background-color: rgba(232, 85, 45, 0.18);
}
.metric__side {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.metric__label {
  font-size: 24rpx;
  color: var(--text-weak);
}
.metric__value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

/* ---- 地址 ---- */
.rest-address {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
  padding-bottom: 8rpx;
}
.addr-pin {
  flex-shrink: 0;
  position: relative;
  width: 22rpx;
  height: 28rpx;
  margin: 4rpx 12rpx 0 0;
}
.addr-pin::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50% 50% 50% 0;
  background-color: var(--text-faint);
  transform: rotate(-45deg);
}
.addr-pin::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 7rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #ffffff;
}
.addr-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-weak);
  line-height: 1.5;
}

/* ---- 操作按钮 ---- */
.card__actions {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 32rpx 32rpx;
}
.btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.btn--ghost {
  color: var(--brand);
  background-color: var(--surface);
  border: 2rpx solid var(--brand);
}
.btn--ghost[disabled] {
  color: var(--text-faint);
  border-color: var(--line);
  background-color: var(--surface);
}
.btn--primary {
  color: #ffffff;
  background: linear-gradient(135deg, #FF7A45 0%, #FF6B35 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.32);
}

.footer-hint {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-faint);
}

/* ===================== 通用状态页（授权/错误） ===================== */
.state {
  min-height: calc(100vh - 120rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  text-align: center;
}
.state__emoji {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 36rpx;
}
.state__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-strong);
}
.state__desc {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: var(--text-weak);
  line-height: 1.6;
}
.state__btn {
  margin-top: 56rpx;
  width: 100%;
  max-width: 520rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #FF7A45 0%, #FF6B35 100%);
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 53, 0.32);
}
.state__note {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--text-faint);
}

/* ===================== 骨架屏 ===================== */
.skeleton .sk-map {
  width: 100%;
  height: 360rpx;
}
.card__body {
  /* 复用，无需额外 */
}
.sk-map,
.sk-line,
.sk-pill {
  background: linear-gradient(90deg, #eef0f2 25%, #f6f7f9 37%, #eef0f2 63%);
  background-size: 400% 100%;
  animation: shimmer 1.3s ease infinite;
}
@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
.sk-line {
  border-radius: 8rpx;
  margin-top: 24rpx;
}
.sk-line--lg { width: 60%; height: 44rpx; margin-top: 8rpx; }
.sk-line--md { width: 80%; height: 28rpx; }
.sk-line--sm { width: 50%; height: 28rpx; }
.sk-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}
.sk-pill {
  width: 140rpx;
  height: 44rpx;
  border-radius: 22rpx;
}
.skeleton .card__body {
  padding-bottom: 40rpx;
}
