/**index.wxss · 全屏地图 + 悬浮底卡（暖食欲橙）**/

.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background-color: #e9e7e3;
}

/* ============ 全屏地图 ============ */
.hero-map {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 附近排行入口 */
.rank-entry {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx 0 18rpx;
  border-radius: 999rpx;
  background: var(--card);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.16);
}
.rank-entry-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='%23ff6b35'%3E%3Cpath%20d='M19%205h-2V3H7v2H5C3.9%205%203%205.9%203%207v1c0%202.55%201.92%204.63%204.39%204.94.63%201.5%201.98%202.63%203.61%202.91V17H8v2h8v-2h-3v-2.15c1.63-.28%202.98-1.41%203.61-2.91C19.08%2012.63%2021%2010.55%2021%208V7c0-1.1-.9-2-2-2zM5%208V7h2v3.82C5.84%2010.4%205%209.3%205%208zm14%200c0%201.3-.84%202.4-2%202.82V7h2v1z'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.rank-entry-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

/* ============ 悬浮底卡 ============ */
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -10rpx 44rpx rgba(31, 31, 34, 0.16);
  padding: 0 40rpx calc(28rpx + env(safe-area-inset-bottom));
  z-index: 2;
}

.grip {
  width: 64rpx;
  height: 7rpx;
  border-radius: 8rpx;
  background: #e6e3df;
  margin: 14rpx auto 6rpx;
}

/* 重新定位按钮：贴在底卡上沿右侧 */
.recenter {
  position: absolute;
  top: -104rpx;
  right: 32rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--card);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(16rpx) scale(0.9);
  pointer-events: none;
  transition: all 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}
.recenter.show {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}
.recenter-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid var(--accent);
  position: relative;
}
.recenter-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  transform: translate(-50%, -50%);
}

/* ============ 底卡内容 ============ */
.sheet-body {
  padding-top: 8rpx;
}

/* 店名 */
.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.shop-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-1);
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* —— 左图 + 右信息 —— */
.info-card {
  display: flex;
  align-items: stretch;
  margin-top: 18rpx;
}
.photo {
  position: relative;
  width: 248rpx;
  height: 196rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #ffb088, #ff7a45);
}
.food-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
}
.photo-index {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  z-index: 4;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(0, 0, 0, 0.36);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.photo-open {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  z-index: 4;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: #1faa53;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}
.photo-open.is-closed {
  background: rgba(60, 60, 64, 0.85);
}

/* 兜底插画：一碗冒热气的面（缩略图版） */
.food-illus {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.illus-bowl {
  position: relative;
  width: 150rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 12rpx 12rpx 80rpx 80rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.14);
}
.illus-bowl::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: -12rpx;
  right: -12rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #fff;
}
.illus-noodle {
  position: absolute;
  top: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 96rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ffd9a0;
  z-index: 2;
}
.illus-steam,
.illus-steam.s2 {
  position: absolute;
  top: -46rpx;
  left: 54rpx;
  width: 7rpx;
  height: 38rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.7);
  animation: steam 2.4s ease-in-out infinite;
  z-index: 2;
}
.illus-steam.s2 {
  left: 90rpx;
  animation-delay: 0.7s;
}

/* 右侧信息列 */
.info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.info-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
  font-size: 24rpx;
}
.i-rating {
  color: #f5a623;
  font-weight: 700;
}
.i-sign {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--brand-deep);
  font-weight: 600;
}
.like-icon {
  width: 26rpx;
  height: 26rpx;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='%23f4511e'%3E%3Cpath%20d='M2%2021h4V9H2v12zm20-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L13.17%201%206.59%207.59C6.22%207.95%206%208.45%206%209v10c0%201.1.9%202%202%202h9c.83%200%201.54-.5%201.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-1.91z'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.i-cost {
  color: var(--text-2);
}

/* 拨打按钮 */
.call-btn {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
  display: flex;
  align-items: center;
  justify-content: center;
}
.call-icon {
  width: 34rpx;
  height: 34rpx;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='%23ff6b35'%3E%3Cpath%20d='M6.62%2010.79c1.44%202.83%203.76%205.14%206.59%206.59l2.2-2.2c.27-.27.67-.36%201.02-.24%201.12.37%202.33.57%203.57.57.55%200%201%20.45%201%201V20c0%20.55-.45%201-1%201-9.39%200-17-7.61-17-17%200-.55.45-1%201-1h3.5c.55%200%201%20.45%201%201%200%201.25.2%202.45.57%203.57.11.35.03.74-.25%201.02l-2.2%202.2z'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* 步行（醒目） */
.walk-big {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.walk-big .walk-icon {
  margin-right: 12rpx;
}
.walk-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-right: 8rpx;
}
.walk-num {
  font-size: 60rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--brand);
}
.walk-unit {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
  margin-left: 6rpx;
}

/* 直线距离（弱化） */
.dist-mini {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 10rpx;
}

/* 步行·脚印图标 */
.walk-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  position: relative;
  flex-shrink: 0;
}
.walk-icon::before,
.walk-icon::after {
  content: '';
  position: absolute;
  width: 7rpx;
  height: 11rpx;
  border-radius: 50%;
  background: var(--brand);
}
.walk-icon::before {
  top: 8rpx;
  left: 9rpx;
  transform: rotate(-18deg);
}
.walk-icon::after {
  top: 13rpx;
  left: 17rpx;
  transform: rotate(-18deg);
  opacity: 0.7;
}

/* 地址 */
.address {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.pin-icon {
  width: 22rpx;
  height: 28rpx;
  position: relative;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.pin-icon::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50% 50% 50% 0;
  background: var(--text-3);
  transform: rotate(-45deg);
}
.pin-icon::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
}
.address-text {
  font-size: 26rpx;
  color: var(--text-2);
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============ 操作栏 ============ */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.change-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 76rpx;
  padding: 0 44rpx;
  border-radius: 999rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border: 2rpx solid var(--brand-line);
  font-size: 28rpx;
  font-weight: 600;
}
.change-btn.is-disabled {
  color: var(--text-3);
  background: #f3f2f0;
  border-color: #ececec;
  opacity: 0.75;
}
.change-icon {
  width: 30rpx;
  height: 30rpx;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='%23ff6b35'%3E%3Cpath%20d='M17.65%206.35A7.958%207.958%200%200012%204a8%208%200%20108%208h-2a6%206%200%2011-6-6c1.66%200%203.14.69%204.22%201.78L13%2011h7V4l-2.35%202.35z'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* 导航图标按钮（FAB） */
.nav-fab {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a5c, var(--brand-deep));
  box-shadow: var(--shadow-btn);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-fab-icon {
  width: 46rpx;
  height: 46rpx;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='%23ffffff'%3E%3Cpath%20d='M21%203L3%2010.53v.98l6.84%202.65L12.48%2021h.98L21%203z'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* ============ 状态页（授权 / 错误） ============ */
.state-screen {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 80rpx;
  text-align: center;
  background: var(--bg);
}
.state-art {
  margin-bottom: 56rpx;
}
.state-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
}
.state-desc {
  font-size: 28rpx;
  color: var(--text-2);
  line-height: 1.6;
  margin-top: 18rpx;
  max-width: 480rpx;
}
.primary-btn {
  margin-top: 56rpx;
  width: 440rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff8a5c, var(--brand-deep));
  box-shadow: var(--shadow-btn);
}

/* 面碗插画 */
.bowl {
  width: 188rpx;
  height: 100rpx;
  margin: 0 auto;
  background: linear-gradient(180deg, #ff9d72, var(--brand));
  border-radius: 16rpx 16rpx 96rpx 96rpx;
  position: relative;
  box-shadow: 0 18rpx 36rpx rgba(255, 107, 53, 0.28);
}
.bowl::before {
  content: '';
  position: absolute;
  top: -14rpx;
  left: -14rpx;
  right: -14rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ffd9c7;
}
.bowl-empty {
  background: linear-gradient(180deg, #d8d5d1, #b7b3ad);
  box-shadow: 0 18rpx 36rpx rgba(31, 31, 34, 0.12);
}
.bowl-empty::before {
  background: #e7e4e0;
}
.bowl-steam {
  position: absolute;
  top: -64rpx;
  left: 56rpx;
  width: 8rpx;
  height: 46rpx;
  border-radius: 8rpx;
  background: rgba(255, 107, 53, 0.35);
  animation: steam 2.4s ease-in-out infinite;
}
.bowl-steam.s2 { left: 90rpx; animation-delay: 0.5s; }
.bowl-steam.s3 { left: 124rpx; animation-delay: 1s; }
@keyframes steam {
  0% { opacity: 0; transform: translateY(8rpx) scaleY(0.8); }
  40% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-18rpx) scaleY(1.2); }
}

/* ============ 骨架屏 ============ */
.skeleton {
  position: absolute;
  inset: 0;
}
.sk-map {
  position: absolute;
  inset: 0;
}
.sk-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 44rpx rgba(31, 31, 34, 0.16);
}
.sk-grip { width: 72rpx; height: 8rpx; border-radius: 8rpx; background: #e6e3df; margin: 0 auto 28rpx; }
.sk-line { border-radius: 10rpx; }
.sk-title { width: 56%; height: 44rpx; }
.sk-tags { display: flex; gap: 16rpx; margin-top: 24rpx; }
.sk-pill { width: 130rpx; height: 40rpx; border-radius: 999rpx; }
.sk-stat { width: 100%; height: 140rpx; border-radius: 24rpx; margin-top: 28rpx; }
.sk-addr { width: 60%; height: 28rpx; margin-top: 28rpx; }
.sk-actions { display: flex; gap: 22rpx; margin-top: 36rpx; }
.sk-btn { flex: 1; height: 92rpx; border-radius: 999rpx; }

.sk-map,
.sk-line,
.sk-pill,
.sk-stat,
.sk-btn {
  background: linear-gradient(100deg, #e7e5e2 30%, #f3f1ee 50%, #e7e5e2 70%);
  background-size: 200% 100%;
  animation: shimmer 1.3s ease-in-out infinite;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
