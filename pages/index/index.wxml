<!--index.wxml-->
<view class="page">

  <!-- ===== 授权引导 ===== -->
  <view class="state state--auth" wx:if="{{!hasLocationAuth}}">
    <view class="state__emoji">🍜</view>
    <view class="state__title">附近面馆</view>
    <view class="state__desc">开启定位，帮你在 3 公里内挑一家不踩雷的面馆</view>
    <button class="state__btn press" bindtap="requestLocationAuth" hover-class="none">开启定位，开始找面</button>
    <view class="state__note">仅用于查找附近面馆，不会上传或保存位置</view>
  </view>

  <!-- ===== 加载骨架屏 ===== -->
  <block wx:elif="{{loading}}">
    <view class="header">
      <view class="header__title">正在为你找面…</view>
      <view class="header__sub">扫描附近 3 公里的面馆</view>
    </view>
    <view class="card skeleton">
      <view class="sk-map"></view>
      <view class="card__body">
        <view class="sk-line sk-line--lg"></view>
        <view class="sk-tags">
          <view class="sk-pill"></view>
          <view class="sk-pill"></view>
        </view>
        <view class="sk-line sk-line--md"></view>
        <view class="sk-line sk-line--sm"></view>
      </view>
    </view>
  </block>

  <!-- ===== 错误状态 ===== -->
  <view class="state state--error" wx:elif="{{error}}">
    <view class="state__emoji">😕</view>
    <view class="state__title">{{error}}</view>
    <view class="state__desc">换个位置，或稍后再试一次</view>
    <button class="state__btn press" bindtap="retryLoad" hover-class="none">重新查找</button>
  </view>

  <!-- ===== 面馆卡片 ===== -->
  <block wx:elif="{{restaurant}}">
    <view class="header">
      <view class="header__title">就吃这家吧 🍜</view>
      <view class="header__sub">已为你找到附近 {{totalCount}} 家 · {{indexLabel}}</view>
    </view>

    <view class="card {{cardEnter ? 'is-enter' : ''}}">
      <!-- 地图 -->
      <view class="card__map">
        <map
          id="restaurantMap"
          class="map"
          longitude="{{mapLongitude}}"
          latitude="{{mapLatitude}}"
          scale="{{mapScale}}"
          markers="{{restaurant.mapMarkers}}"
          show-location="true"
          enable-zoom="true"
          enable-scroll="true"
          enable-rotate="false"
          enable-poi="false"
          enable-building="false"
          show-compass="false"
          show-scale="false"
          bindtap="onMapTap"
          bindregionchange="onMapRegionChange"
          bindscalechange="onMapScaleChange"
        ></map>
        <view class="map__locate press {{showLocationBtn ? 'is-show' : ''}}" bindtap="moveToUserLocation">
          <view class="locate-pin"></view>
        </view>
      </view>

      <!-- 信息 -->
      <view class="card__body">
        <view class="rest-name">{{restaurant.name}}</view>

        <view class="rest-tags">
          <view class="pill pill--primary">{{restaurant.tag}}</view>
          <view class="pill pill--accent">{{restaurant.randomTag}}</view>
        </view>

        <view class="rest-metric">
          <view class="metric__main">
            <text class="metric__num">{{restaurant.walkingTime}}</text>
            <text class="metric__unit">分钟</text>
          </view>
          <view class="metric__divider"></view>
          <view class="metric__side">
            <view class="metric__label">步行可达</view>
            <view class="metric__value">约 {{restaurant.distance}} 米</view>
          </view>
        </view>

        <view class="rest-address">
          <view class="addr-pin"></view>
          <text class="addr-text">{{restaurant.address}}</text>
        </view>
      </view>

      <!-- 操作 -->
      <view class="card__actions">
        <button class="btn btn--ghost press" bindtap="changeRestaurant" disabled="{{searchedRestaurants.length <= 1}}" hover-class="none">换一家</button>
        <button class="btn btn--primary press" bindtap="openNavigation" hover-class="none">去这家</button>
      </view>
    </view>

    <view class="footer-hint">想不出吃啥？点「换一家」让它帮你选</view>
  </block>

</view>
