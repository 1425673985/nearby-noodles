<!--index.wxml-->
<view class="page">

  <!-- ① 加载骨架屏 -->
  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-map"></view>
    <view class="sk-sheet">
      <view class="sk-grip"></view>
      <view class="sk-line sk-title"></view>
      <view class="sk-tags">
        <view class="sk-pill"></view>
        <view class="sk-pill"></view>
      </view>
      <view class="sk-stat"></view>
      <view class="sk-line sk-addr"></view>
      <view class="sk-actions">
        <view class="sk-btn"></view>
        <view class="sk-btn"></view>
      </view>
    </view>
  </view>

  <!-- ② 定位授权引导 -->
  <view class="state-screen" wx:elif="{{!hasLocationAuth}}">
    <view class="state-art">
      <view class="bowl">
        <view class="bowl-steam"></view>
        <view class="bowl-steam s2"></view>
        <view class="bowl-steam s3"></view>
      </view>
    </view>
    <view class="state-title">先开启定位吧</view>
    <view class="state-desc">授权位置后，帮你找到走几步就能到的那碗面</view>
    <button class="primary-btn tap-shrink" bindtap="requestLocationAuth">开启定位</button>
  </view>

  <!-- ③ 错误 / 空状态 -->
  <view class="state-screen" wx:elif="{{error}}">
    <view class="state-art">
      <view class="bowl bowl-empty"></view>
    </view>
    <view class="state-title">没找到合适的面馆</view>
    <view class="state-desc">{{error}}</view>
    <button class="primary-btn tap-shrink" bindtap="retryLoad">重新找一找</button>
  </view>

  <!-- ④ 主内容：全屏地图 + 悬浮底卡 -->
  <block wx:elif="{{restaurant}}">
    <!-- 全屏地图背景 -->
    <map
      id="restaurantMap"
      class="hero-map"
      longitude="{{mapLongitude}}"
      latitude="{{mapLatitude}}"
      scale="{{mapScale}}"
      markers="{{restaurant.mapMarkers}}"
      show-location="true"
      enable-zoom="true"
      enable-scroll="true"
      enable-rotate="false"
      enable-poi="true"
      enable-building="true"
      show-compass="false"
      show-scale="false"
      bindtap="onMapTap"
      bindregionchange="onMapRegionChange"
      bindscalechange="onMapScaleChange"
    ></map>

    <!-- 悬浮底卡 -->
    <view class="sheet">
      <!-- 重新定位（贴在底卡上沿） -->
      <view class="recenter tap-shrink {{showLocationBtn ? 'show' : ''}}" bindtap="moveToUserLocation">
        <view class="recenter-icon"></view>
      </view>

      <view class="grip"></view>

      <view class="sheet-body">
        <!-- 店名 + 拨打 -->
        <view class="name-row">
          <text class="shop-name">{{restaurant.name}}</text>
          <view class="call-btn tap-shrink" wx:if="{{restaurant.tel}}" bindtap="callShop">
            <view class="call-icon"></view>
          </view>
        </view>

        <!-- 左图 + 右信息 -->
        <view class="info-card">
          <!-- 左：门店图（点击放大） -->
          <view class="photo" bindtap="previewPhoto">
            <view class="food-illus">
              <view class="illus-bowl">
                <view class="illus-noodle"></view>
                <view class="illus-steam"></view>
                <view class="illus-steam s2"></view>
              </view>
            </view>
            <image
              wx:if="{{!foodImgError}}"
              class="food-photo"
              src="{{restaurant.foodImage}}"
              mode="aspectFill"
              lazy-load="true"
              binderror="onFoodImgError"
            ></image>
            <!-- 推荐理由角标 -->
            <view class="photo-badge {{restaurant.highlight === 'rating' ? 'is-rating' : 'is-distance'}}" wx:if="{{restaurant.highlight}}">
              {{restaurant.highlight === 'rating' ? '高分推荐' : '离你最近'}}
            </view>
            <view class="photo-open {{restaurant.openClosed ? 'is-closed' : ''}}" wx:if="{{restaurant.openText}}">{{restaurant.openText}}</view>
            <!-- 点击放大提示 -->
            <view class="photo-zoom" wx:if="{{!foodImgError}}"></view>
          </view>

          <!-- 右：精简信息 -->
          <view class="info">
            <view class="info-line">
              <text class="i-rating {{restaurant.highlight === 'rating' ? 'hl' : ''}}" wx:if="{{restaurant.rating}}">★ {{restaurant.rating}}</text>
              <view class="i-sign" wx:if="{{restaurant.signature.length}}">
                <view class="like-icon"></view>
                <text>{{restaurant.signature[0]}}</text>
              </view>
              <text class="i-cost" wx:if="{{restaurant.cost}}">¥{{restaurant.cost}}/人</text>
            </view>

            <view class="walk-big {{restaurant.highlight === 'distance' ? 'hl' : ''}}">
              <view class="walk-icon"></view>
              <text class="walk-label">步行约</text>
              <text class="walk-num">{{restaurant.walkingTime}}</text>
              <text class="walk-unit">分钟</text>
            </view>

            <text class="dist-mini">直线 {{restaurant.distance}}m</text>
          </view>
        </view>

        <!-- 地址 -->
        <view class="address">
          <view class="pin-icon"></view>
          <text class="address-text">{{restaurant.address}}</text>
        </view>
      </view>

      <!-- 操作栏：换一家 / 点赞 / 排行 / 导航 -->
      <view class="toolbar">
        <view class="tool tap-shrink {{candidates.length <= 1 ? 'is-disabled' : ''}}" bindtap="changeRestaurant">
          <view class="tool-ic ic-change"></view>
          <text class="tool-tx">换一家</text>
        </view>
        <view class="tool tap-shrink {{liked ? 'is-liked' : ''}}" bindtap="toggleLike">
          <view class="tool-ic ic-like"></view>
          <text class="tool-tx">{{liked ? '已赞' : '点赞'}}</text>
        </view>
        <view class="tool tool-rank tap-shrink" bindtap="goRank">
          <view class="tool-ic ic-rank"></view>
          <text class="tool-tx">排行</text>
        </view>
        <view class="tool tool-nav tap-shrink" bindtap="openNavigation">
          <view class="tool-ic ic-nav"></view>
          <text class="tool-tx">导航</text>
        </view>
      </view>
    </view>
  </block>

</view>
