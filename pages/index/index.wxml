<!--index.wxml-->
<view class="page">

  <!-- ① 加载骨架屏 -->
  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-map"></view>
    <view class="sk-sheet">
      <view class="sk-grip"></view>
      <view class="sk-line sk-title"></view>
      <view class="sk-tags">
        <view class="sk-pill"></view>
        <view class="sk-pill"></view>
      </view>
      <view class="sk-stat"></view>
      <view class="sk-line sk-addr"></view>
      <view class="sk-actions">
        <view class="sk-btn"></view>
        <view class="sk-btn"></view>
      </view>
    </view>
  </view>

  <!-- ② 定位授权引导 -->
  <view class="state-screen" wx:elif="{{!hasLocationAuth}}">
    <view class="state-art">
      <view class="bowl">
        <view class="bowl-steam"></view>
        <view class="bowl-steam s2"></view>
        <view class="bowl-steam s3"></view>
      </view>
    </view>
    <view class="state-title">先开启定位吧</view>
    <view class="state-desc">授权位置后，帮你找到走几步就能到的那碗面</view>
    <button class="primary-btn tap-shrink" bindtap="requestLocationAuth">开启定位</button>
  </view>

  <!-- ③ 错误 / 空状态 -->
  <view class="state-screen" wx:elif="{{error}}">
    <view class="state-art">
      <view class="bowl bowl-empty"></view>
    </view>
    <view class="state-title">没找到合适的面馆</view>
    <view class="state-desc">{{error}}</view>
    <button class="primary-btn tap-shrink" bindtap="retryLoad">重新找一找</button>
  </view>

  <!-- ④ 主内容：全屏地图 + 悬浮底卡 -->
  <block wx:elif="{{restaurant}}">
    <!-- 全屏地图背景 -->
    <map
      id="restaurantMap"
      class="hero-map"
      longitude="{{mapLongitude}}"
      latitude="{{mapLatitude}}"
      scale="{{mapScale}}"
      markers="{{restaurant.mapMarkers}}"
      show-location="true"
      enable-zoom="true"
      enable-scroll="true"
      enable-rotate="false"
      enable-poi="true"
      enable-building="true"
      show-compass="false"
      show-scale="false"
      bindtap="onMapTap"
      bindregionchange="onMapRegionChange"
      bindscalechange="onMapScaleChange"
    ></map>

    <!-- 悬浮底卡 -->
    <view class="sheet">
      <!-- 重新定位（贴在底卡上沿） -->
      <view class="recenter tap-shrink {{showLocationBtn ? 'show' : ''}}" bindtap="moveToUserLocation">
        <view class="recenter-icon"></view>
      </view>

      <view class="grip"></view>

      <view class="sheet-body">
        <!-- 紧凑头部：左侧食欲小图 + 右侧店名/标签 -->
        <view class="head-card">
          <!-- 食欲缩略图 -->
          <view class="thumb">
            <view class="food-illus">
              <view class="illus-bowl">
                <view class="illus-noodle"></view>
                <view class="illus-steam"></view>
                <view class="illus-steam s2"></view>
              </view>
            </view>
            <image
              wx:if="{{!foodImgError}}"
              class="food-photo"
              src="{{restaurant.foodImage}}"
              mode="aspectFill"
              lazy-load="true"
              binderror="onFoodImgError"
            ></image>
            <view class="thumb-index" wx:if="{{searchedRestaurants.length > 1}}">{{currentIndex + 1}}/{{searchedRestaurants.length}}</view>
          </view>

          <!-- 右侧信息 -->
          <view class="head-info">
            <view class="head-line">
              <text class="name">{{restaurant.name}}</text>
              <view class="call-btn tap-shrink" wx:if="{{restaurant.tel}}" bindtap="callShop">
                <view class="call-icon"></view>
              </view>
            </view>
            <view class="tags">
              <view class="tag tag-cat">{{restaurant.category}}</view>
              <view class="tag tag-primary">{{restaurant.tag}}</view>
              <view class="tag tag-random">{{restaurant.randomTag}}</view>
            </view>
          </view>
        </view>

        <!-- 数据面板：步行时间 + 直线距离 -->
        <view class="stat-panel">
          <view class="stat">
            <view class="stat-top">
              <view class="walk-icon"></view>
              <text class="stat-label">步行约</text>
            </view>
            <view class="stat-value">
              <text class="num">{{restaurant.walkingTime}}</text>
              <text class="unit">分钟</text>
            </view>
          </view>
          <view class="stat-divider"></view>
          <view class="stat">
            <view class="stat-top">
              <text class="stat-label">直线距离</text>
            </view>
            <view class="stat-value">
              <text class="num">{{restaurant.distance}}</text>
              <text class="unit">米</text>
            </view>
          </view>
        </view>

        <!-- 地址 -->
        <view class="address">
          <view class="pin-icon"></view>
          <text class="address-text">{{restaurant.address}}</text>
        </view>
      </view>

      <!-- 操作栏 -->
      <view class="action-bar">
        <button class="act act-ghost tap-shrink" bindtap="changeRestaurant" disabled="{{searchedRestaurants.length <= 1}}">
          换一家
        </button>
        <button class="act act-primary tap-shrink" bindtap="openNavigation">
          去这家
        </button>
      </view>
    </view>
  </block>

</view>
